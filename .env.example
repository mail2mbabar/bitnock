# Database
ConnectionStrings__Database=Host=localhost;Port=5432;Database=bitnock;Username=bitnock;Password=CHANGE_ME

# Site
Site__Name=Bitnock
Site__Description=Bitnock is Muhammad Babar’s .NET engineering publication. C#, ASP.NET Core, Azure, and the ABi Helpline videos — with written guides.
Site__Url=http://localhost:3000
Site__DefaultAuthorSlug=muhammad-babar
Site__Social__GitHub=https://github.com/mail2mbabar
Site__Social__LinkedIn=https://www.linkedin.com/in/dev-mbabar
Site__Social__YouTube=https://www.youtube.com/@ABiHelpline

# Auth  — 32+ character signing key. Never reuse the development value in production.
Jwt__Issuer=nexus
Jwt__Audience=nexus-web
Jwt__SigningKey=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_32+
Jwt__AccessTokenMinutes=20
Jwt__RefreshTokenDays=14

# Storage
Storage__Provider=Local
Storage__LocalRoot=storage
Storage__PublicBaseUrl=http://localhost:5080/media
Storage__MaxFileSizeBytes=5242880

# Publishing
Publishing__Mode=RequireApproval
Publishing__MinimumContentLength=400
Publishing__RequireFeaturedImage=false
Publishing__RequireSeoTitle=true
Publishing__RequireMetaDescription=true

# CORS
Cors__AllowedOrigins__0=http://localhost:3000

# Rate limits
RateLimits__AgentPermitLimit=60

# DEVELOPMENT ONLY seed. Disable in production.
Seed__Enabled=true
Seed__DevAdminEmail=admin@localhost
Seed__DevAdminPassword=DevOnly!Nexus2026

# Frontend
API_URL=http://localhost:5080
NEXT_PUBLIC_API_URL=http://localhost:5080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
